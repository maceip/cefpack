  sources = [
    "$root_gen_dir/base/tracing/protos/tracing_proto_resources.pak",
    "$root_gen_dir/components/ukm_resources.pak",
    "$root_gen_dir/content/browser/resources/media/media_internals_resources.pak",
    "$root_gen_dir/content/browser/webrtc/resources/webrtc_internals_resources.pak",
    "$root_gen_dir/content/content_resources.pak",
    "$root_gen_dir/content/gpu_resources.pak",
    "$root_gen_dir/content/histograms_resources.pak",
    "$root_gen_dir/content/process_resources.pak",
    "$root_gen_dir/content/quota_internals_resources.pak",
    "$root_gen_dir/content/service_worker_resources.pak",
    "$root_gen_dir/mojo/public/js/mojo_bindings_resources.pak",
    "$root_gen_dir/net/net_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_scaled_resources_100_percent.pak",
    "$root_gen_dir/third_party/blink/public/resources/inspector_overlay_resources.pak",
    "$root_gen_dir/third_party/blink/public/strings/blink_strings_en-US.pak",
    "$root_gen_dir/third_party/blink/public/strings/permission_element_generated_strings.pak",
    "$root_gen_dir/third_party/blink/public/strings/permission_element_strings_en-US.pak",
    "$root_gen_dir/ui/resources/ui_lottie_resources.pak",
    "$root_gen_dir/ui/resources/ui_resources_100_percent.pak",
    "$root_gen_dir/ui/strings/app_locale_settings_en-US.pak",
    "$root_gen_dir/ui/strings/auto_image_annotation_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ax_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ui_strings_en-US.pak",
    "$root_gen_dir/ui/webui/resources/webui_resources.pak",
  ]

  deps = [
    "//base/tracing/protos:chrome_track_event_resources",
    "//components/ukm/debug:resources",
    "//content:content_resources",
    "//content/browser/resources",
    "//content/browser/resources/media:resources",
    "//content/browser/webrtc/resources",
    "//mojo/public/js:resources",
    "//net:net_resources",
    "//third_party/blink/public:devtools_inspector_resources",
    "//third_party/blink/public:resources",
    "//third_party/blink/public:scaled_resources_100_percent",
    "//third_party/blink/public/strings",
    "//third_party/blink/public/strings:permission_element_generated_strings",
    "//third_party/blink/public/strings:permission_element_strings",
    "//ui/resources",
    "//ui/strings",
    "//ui/webui/resources",
  ]

  output = "$root_out_dir/cefpack_resources.pak"
}

source_set("cefpack_webview_native") {
  sources = [
    "cefpack_browser_context.cc",
    "cefpack_browser_context.h",
    "cefpack_content_browser_client.cc",
    "cefpack_content_browser_client.h",
    "cefpack_content_client.cc",
    "cefpack_content_client.h",
    "cefpack_descriptors.h",
    "cefpack_devtools_bridge.cc",
    "cefpack_devtools_bridge.h",
    "cefpack_engine.cc",
    "cefpack_main_delegate.cc",
    "cefpack_main_delegate.h",
    "cefpack_session.cc",
    "cefpack_session.h",
    "cefpack_throttles.cc",
    "cefpack_throttles.h",
  ]

  public_deps = [
    ":cefpack_jni_headers",
    "//content/public/app",
    "//content/public/browser",
    "//content/public/child",
    "//content/public/common",
    "//content/public/gpu",
    "//content/public/renderer",
    "//content/public/utility",
    "//services/network:network_service",
  ]

  deps = [
    "//base",
    "//base:base_static",
    "//components/embedder_support",
    "//components/embedder_support:user_agent",
    "//components/embedder_support/android:view",
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    "//components/memory_system",
    "//content:content_resources",
    "//media",
    "//net",
    "//net:net_resources",
    "//net/traffic_annotation",
    "//services/cert_verifier/public/mojom",
    "//services/media_session/public/mojom",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//skia",
    "//third_party/blink/public:blink",
    "//third_party/blink/public/common",
    "//ui/android",
    "//ui/base",
    "//ui/gfx",
    "//ui/gfx/geometry",
    "//url",
    "//v8",
  ]
}

shared_library_with_jni("libcefpack_content") {
  sources = [ "cefpack_library_loader.cc" ]

  deps = [
    ":cefpack_jni_headers",
    ":cefpack_pak",
    ":cefpack_webview_native",
    "//media",
    "//skia",
  ]

  java_targets = [ ":cefpack_webview_java" ]
  add_stubs_for_missing_jni = true
  remove_uncalled_jni = true

  configs -= [ "//build/config/android:hide_all_but_jni_onload" ]
  configs += [ "//build/config/android:hide_all_but_jni" ]
  ldflags = [ "-Wl,-z,max-page-size=16384" ]
}

android_resources("cefpack_webview_resources") {
  sources = [ "res/values/strings.xml" ]
}

android_library("cefpack_webview_java") {
  enable_errorprone = false
  resources_package = "dev.cefpack.android"

  sources = [
    "java/src/dev/cefpack/android/CefpackEngine.java",
    "java/src/dev/cefpack/android/CefpackSession.java",
    "java/src/dev/cefpack/android/CefpackViewAndroidDelegate.java",
  ]

  srcjar_deps = [ ":cefpack_jni_headers" ]

  deps = [
    ":cefpack_webview_resources",
    "//base:base_java",
    "//base:process_launcher_java",
    "//build/android:build_java",
    "//components/embedder_support/android:content_view_java",
    "//components/embedder_support/android:view_java",
    "//components/viz/service:service_java",
    "//content/public/android:content_java",
    "//media/base/android:media_java",
    "//media/capture/video/android:capture_java",
    "//mojo/public/java:system_java",
    "//net/android:net_java",
    "//third_party/jni_zero:jni_zero_java",
    "//ui/android:ui_java",
    "//ui/base/cursor/mojom:cursor_type_java",
    "//url:gurl_java",
  ]
}

android_library("cefpack_jni_registration_java") {
  enable_errorprone = false
  srcjar_deps = [ ":libcefpack_content__jni_registration" ]
  deps = [ "//third_party/jni_zero:jni_zero_java" ]
}

generate_build_config_srcjar("cefpack_build_config_srcjar") {
}

generated_file("cefpack_shared_library_list") {
  deps = [ ":libcefpack_content" ]
  outputs = [ "$target_gen_dir/cefpack.native_libs" ]
  data_keys = [ "shared_libraries" ]
  walk_keys = [ "shared_libraries_barrier" ]
  rebase = root_build_dir
}

write_native_libraries_java("cefpack_native_libraries_srcjar") {
  enable_chromium_linker = false
  use_final_fields = true
  native_lib_64_bit = true
  native_libraries_list_file = "$target_gen_dir/cefpack.native_libs"
  deps = [ ":cefpack_shared_library_list" ]
}

android_library("cefpack_build_info_java") {
  enable_errorprone = false
  srcjar_deps = [
    ":cefpack_build_config_srcjar",
    ":cefpack_native_libraries_srcjar",
  ]
  deps = [ "//build/android:build_java" ]
}

dist_aar("cefpack_base_aar") {
  deps = [
    ":cefpack_build_info_java",
    ":cefpack_jni_registration_java",
    ":cefpack_pak",
    ":cefpack_webview_java",
    ":libcefpack_content",
    "//third_party/icu:icudata",
  ]

  android_manifest = "AndroidManifest.xml"
  output = "$root_out_dir/cefpack_base.aar"

  jar_excluded_patterns = [
    "META-INF/*",
    "META-INF/*/*",
    "META-INF/*/*/*",
    "META-INF/*/*/*/*",
    "*.kotlin_module",
    "module-info.class",
    "dev/cefpack/android/R.class",
    "dev/cefpack/android/R\$*.class",
    "org/chromium/*/R.class",
    "org/chromium/*/R\$*.class",
    "org/chromium/*/*/R.class",
    "org/chromium/*/*/R\$*.class",
    "org/chromium/*/*/*/R.class",
    "org/chromium/*/*/*/R\$*.class",
    "org/chromium/*/*/*/*/R.class",
    "org/chromium/*/*/*/*/R\$*.class",
    "androidx/*/R.class",
    "androidx/*/R\$*.class",
    "androidx/*/*/R.class",
    "androidx/*/*/R\$*.class",
    "com/google/android/gms/*",
    "com/google/firebase/*",
    "com/google/mlkit/*",
    "org/chromium/content/browser/sms/*",
  ]
}

group("cefpack_webview_all") {
  deps = [
    ":cefpack_base_aar",
    ":cefpack_pak",
    ":libcefpack_content",
    "//third_party/icu:icudata",
  ]
}
