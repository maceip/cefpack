+# The shared library of the engine, for the measurement of the link.
+#
+# The engine of the browser is a shared library that carries the layer of
+# the content of Chromium: the renderer, the browser side of the content,
+# and Blink.  The link of that library is the step that costs the most
+# memory of the whole build, and it is measured on its own before anything
+# is written on top of it.
+#
+# The target carries one object of its own and the layer of the content.
+# Nothing else: the browser of the application is rendered off screen, and
+# the shell of the desktop is not part of it.
+shared_library("content_link_measurement") {
+  testonly = true
+
+  sources = [ "content_link_measurement.cc" ]
+
+  deps = [
+    "//content/public/app",
+    "//content/public/browser",
+  ]
+
+  # The shared libraries of Android hide every symbol but the entry point
+  # of the JNI, and the C API of the engine has to be visible from outside
+  # of the library.
+  configs -= [ "//build/config/android:hide_all_but_jni_onload" ]
+}
+
 if (is_android) {
   group("content_shell_freeze_test") {
     testonly = true
