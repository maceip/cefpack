diff --git a/BUILD.gn b/BUILD.gn
index 2018b0d..a77e19c 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -252,10 +252,10 @@ if (is_linux) {
 #
 
 # Enable support for Print Preview.
-assert(enable_print_preview)
+assert(enable_print_preview || is_android)
 
 # Enable support for Widevine CDM.
-assert(enable_widevine)
+assert(enable_widevine || is_android)
 
 if (is_mac || is_win) {
   # Enable Widevine CDM host verification and storage ID.
@@ -266,7 +266,7 @@ if (is_mac || is_win) {
 }
 
 # Enable Views UI framework.
-assert(toolkit_views)
+assert(toolkit_views || is_android)
 
 if (is_clang) {
   # Don't use the chrome style plugin.
@@ -3065,3 +3065,19 @@ if (is_mac) {
     }
   }
 }
+
+# The root of the build of an engine for Android: the engine, and the shim
+# of the C API that the application links against.
+#
+# The group is test-only because `libcef` is: CEF marks the engine as
+# test-only so that it may depend on `libcef_test_support`, which is
+# test-only.  GN refuses a dependency of a normal target on a test-only one:
+#
+#     ERROR at //cef/BUILD.gn:1:1: Test-only dependency not allowed.
+group("cef_android") {
+  testonly = true
+  deps = [
+    ":libcef",
+    ":libcef_dll_wrapper",
+  ]
+}
