diff --git a/ui/base/BUILD.gn b/ui/base/BUILD.gn
--- a/ui/base/BUILD.gn
+++ b/ui/base/BUILD.gn
@@ -1299,10 +1299,14 @@
   }
 
   if (is_android) {
-    deps += [
-      "//chrome:resources",
-      "//ui/android:ui_java",
-    ]
+    deps += [ "//ui/android:ui_java" ]
+    # The resources of the browser are the resources of the *browser*.  A
+    # build that is rooted in the tree of Chromium has no browser, and the
+    # file that holds the resources is the file of the browser — and
+    # Chromium reads every target of a file that it reads.
+    if (root != "//") {
+      deps += [ "//chrome:resources" ]
+    }
   }
 
   if (use_pangocairo) {
