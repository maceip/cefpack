+    deps += [ "//ui/android:ui_java" ]
+    # The resources of the browser are the resources of the *browser*.  A
+    # build of the content alone has no browser, and the file that holds
+    # the resources is the file of the browser — and Chromium reads every
+    # target of a file that it reads.
+    if (!cef_content_only) {
+      deps += [ "//chrome:resources" ]
