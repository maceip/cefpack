diff --git a/build/config/BUILDCONFIG.gn b/build/config/BUILDCONFIG.gn
--- a/build/config/BUILDCONFIG.gn
+++ b/build/config/BUILDCONFIG.gn
@@ -121,6 +121,18 @@
 #
 # - Don't call exec_script inside declare_args. This will execute the script
 #   even if the value is overridden, which is wasteful. See first bullet.
+
+declare_args() {
+  # The build of the content of Chromium alone: the engine of CEF is not
+  # built, and the browser of Chromium with it.
+  #
+  # The resources of the browser are the resources of the *browser*, and
+  # the file that holds them is the file of the browser — and Chromium
+  # reads every target of a file that it reads.  A build of the content
+  # alone has no browser, and the resources of the browser are not asked
+  # for.
+  cef_content_only = false
+}
 
 declare_args() {
   # Set to enable the official build level of optimization. This has nothing
